{
  "$schema": "http://json.schemastore.org/template",
  "author": "SelectPdf",
  "classifications": [
    "Console",
    "PDF"
  ],
  "identity": "SelectPdf.Templates.Console",
  "groupIdentity": "SelectPdf.Templates.Console",
  "name": "HTML to PDF Console App (SelectPdf)",
  "shortName": "selectpdf-console",
  "description": "Console app that converts a URL or an HTML file to PDF with SelectPdf's Chromium engine. Runs on Windows, Linux x64/ARM64 and macOS (Apple Silicon).",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "SelectPdfConsole",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "Target framework.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "net10.0",
          "description": ".NET 10 (LTS)"
        },
        {
          "choice": "net8.0",
          "description": ".NET 8 (LTS)"
        }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    },
    "Edition": {
      "type": "parameter",
      "description": "SelectPdf edition.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "community",
          "description": "Free Community Edition: HTML to PDF, up to 5 pages per document"
        },
        {
          "choice": "full",
          "description": "SelectPdf.Universal (licensed): no page limit, merging, PDF/UA, Word to PDF"
        }
      ],
      "defaultValue": "community"
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "If specified, skips the automatic restore of the project on create.",
      "defaultValue": "false"
    }
  },
  "primaryOutputs": [
    {
      "path": "SelectPdfConsole.csproj"
    }
  ],
  "postActions": [
    {
      "description": "Restore NuGet packages required by this project.",
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": true,
      "condition": "(!skipRestore)"
    }
  ]
}