<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- SelectPdf's Chromium engine for the machine that builds the app: your dev box locally, Linux x64/ARM64 in Docker.
       Publishing with -r <rid> picks that platform instead (win-x64, win-x86, linux-x64, linux-arm64, osx-arm64). -->
  <PropertyGroup>
    <_SelectPdfArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_SelectPdfArch>
    <SelectPdfRid Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-$(_SelectPdfArch)</SelectPdfRid>
    <SelectPdfRid Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-$(_SelectPdfArch)</SelectPdfRid>
    <SelectPdfRid Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-$(_SelectPdfArch)</SelectPdfRid>
    <SelectPdfRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</SelectPdfRid>
  </PropertyGroup>

  <ItemGroup>
<!--#if (Edition == "full") -->
    <PackageReference Include="SelectPdf.Universal" Version="26.4.0" />
<!--#else -->
    <PackageReference Include="SelectPdf.HtmlToPdf.Universal" Version="26.4.0" />
<!--#endif -->
    <PackageReference Include="SelectPdf.Universal.Native.$(SelectPdfRid)" Version="26.4.0" />
  </ItemGroup>

</Project>
